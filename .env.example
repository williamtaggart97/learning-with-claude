# Copy to .env.local and fill in. Never commit .env.local.

# ── Database (Postgres) ─────────────────────────────────────────────
# Runtime connection (Neon: the POOLED url, e.g. ...-pooler...).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_mode"
# Migrations / Prisma CLI (Neon: the DIRECT, unpooled url). Optional locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/learning_mode"

# ── Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# Model overrides (defaults in src/config.ts)
# ROUTER_MODEL="claude-haiku-4-5-20251001"
# ANSWERER_MODEL="claude-sonnet-5"
# ASSESSOR_MODEL="claude-haiku-4-5-20251001"

# ── Passcode gate ───────────────────────────────────────────────────
# Dev: leave DEMO_PASSCODE empty to disable the gate.
# Production (NODE_ENV=production): BOTH are required, otherwise the app
# fails closed (pages show a misconfiguration notice, APIs return 503) —
# unless DISABLE_PASSCODE_GATE=1 is set explicitly.
DEMO_PASSCODE=""
# Random string used to HMAC the passcode cookie (e.g. `openssl rand -hex 32`).
PASSCODE_SECRET=""
# DISABLE_PASSCODE_GATE=1
# Passcode attempts per IP per window
# PASSCODE_MAX_ATTEMPTS=10
# PASSCODE_WINDOW_MINUTES=15

# ── Rate limits (fixed windows; chat routes check all three) ────────
# Per browser session
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MINUTES=60
# Per client IP
# RATE_LIMIT_IP_MAX=120
# RATE_LIMIT_IP_WINDOW_MINUTES=60
# Whole app, per UTC day
# RATE_LIMIT_GLOBAL_DAILY_MAX=2000
