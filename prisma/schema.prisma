// Learning mode — database schema (spec A7).
//
// Prisma 7 notes:
//  - Connection URLs are NOT in this file. The CLI (migrate/studio) reads them
//    from prisma.config.ts (DIRECT_URL, falling back to DATABASE_URL); the
//    runtime client connects through the pg driver adapter with DATABASE_URL
//    (see src/lib/db.ts). This replaces the old `url` / `directUrl` fields.
//  - The client is generated into src/generated/prisma (gitignored). Import
//    it as `@/generated/prisma/client`.
//
// Ownership model: every per-user row hangs off `User` with onDelete: Cascade,
// so a persona reset is "delete the session clone User, re-copy the template".
// `Concept` is a shared catalog and is never deleted by a reset. Exception:
// `SlotImpression` (experiment data) uses SetNull foreign keys plus snapshot
// id columns, so it survives persona resets.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum MessageRole {
  user
  assistant
}

/// text: plain user or assistant message (data = null).
/// framing: assistant message showing framing questions. data = { exchangeId }
///   only; questions/responses/status live on the FramingExchange (single
///   source of truth) and are joined into the MessageDTO server-side.
/// answer: assistant answer. data = { calloutItemIds?: string[] } (lookup
///   callouts, already persisted as LearnLaterItem rows) or null.
enum MessageKind {
  text
  framing
  answer
}

enum ConversationOrigin {
  chat
  dig_in
}

/// skipped: user chose "just answer" — the concept goes to Learn It Later
/// (origin = skipped) and the exchange does NOT count toward progress.
enum FramingStatus {
  pending
  answered
  skipped
}

enum EntryPoint {
  code
  concept
  worked_example
}

enum LearnLaterStatus {
  queued
  dug_in
  dismissed
}

/// skipped: user deferred a concept; flagged: Claude surfaced it (lookup callout / assessor).
enum LearnLaterOrigin {
  skipped
  flagged
}

enum PersonaKey {
  maya
  dev
  sam
}

/// End-of-answer slot variants (E1): A card · B walkthrough · C quickcheck ·
/// D apply · E none (control).
enum SlotVariant {
  card
  walkthrough
  quickcheck
  apply
  none
}

/// The first engagement recorded on a slot impression (E5 primary metric).
enum SlotEngagement {
  dig_in
  walkthrough_started
  quickcheck_answered
  apply_clicked
}

// ─── Users & personas ───────────────────────────────────────────────────────

/// Template rows (isTemplate = true, demoSessionId = "template" — the
/// TEMPLATE_DEMO_SESSION_ID sentinel in src/config.ts) hold the canonical
/// persona seed; the unique (demoSessionId, personaKey) therefore enforces one
/// template per persona. Each browser session gets a clone (isTemplate = false,
/// demoSessionId = session cookie value, never the sentinel).
model User {
  id             String     @id @default(cuid())
  /// Browser-session cookie value, or "template" for persona templates.
  demoSessionId  String
  personaKey     PersonaKey
  isTemplate     Boolean    @default(false)
  displayName    String
  createdAt      DateTime   @default(now())
  /// Bumped when the session clone is used; lets a future job delete stale clones.
  lastSeenAt     DateTime   @default(now())
  /// Set by the assessor (A3) at the end of each run; exposed as ProfileDTO.lastAssessedAt.
  lastAssessedAt DateTime?

  conversations    Conversation[]
  framingExchanges FramingExchange[]
  conceptMastery   ConceptMastery[]
  learningStyle    LearningStyle?
  userContext      UserContext?
  learnLaterItems  LearnLaterItem[]
  slotImpressions  SlotImpression[]

  @@unique([demoSessionId, personaKey])
  @@index([isTemplate, personaKey])
}

// ─── Chat ───────────────────────────────────────────────────────────────────

model Conversation {
  id               String             @id @default(cuid())
  userId           String
  title            String             @default("New chat")
  origin           ConversationOrigin @default(chat)
  /// Set for dig-in chats: the Learn It Later item this chat was opened from.
  learnLaterItemId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnLaterItem   LearnLaterItem?   @relation("DigInConversations", fields: [learnLaterItemId], references: [id], onDelete: SetNull)
  messages         Message[]
  framingExchanges FramingExchange[]
  /// Learn It Later items that originated in this conversation.
  sourcedItems     LearnLaterItem[]  @relation("LearnLaterSourceConversation")
  slotImpressions  SlotImpression[]

  @@index([userId, updatedAt])
  @@index([learnLaterItemId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  kind           MessageKind @default(text)
  /// Markdown text. Empty string for pure framing messages is allowed.
  content        String
  /// Structured extras, e.g. framing questions or lookup callouts.
  data           Json?
  createdAt      DateTime    @default(now())

  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggeredFraming  FramingExchange? @relation("FramingUserMessage")
  framingForMessage FramingExchange? @relation("FramingQuestionsMessage")
  answeredFraming   FramingExchange? @relation("FramingAnswerMessage")
  sourcedLearnLater LearnLaterItem[] @relation("LearnLaterSourceMessage")
  /// Set on answer messages that ended with an end-of-answer slot (E1).
  slotImpression    SlotImpression?

  @@index([conversationId, createdAt])
}

/// One round of framing questions for a concept question. Progress (P7)
/// counts rows with status = answered only (not pending, not skipped).
model FramingExchange {
  id               String        @id @default(cuid())
  userId           String
  conversationId   String
  /// The user message that triggered framing.
  userMessageId    String        @unique
  /// The assistant message (kind = framing) that displays the questions.
  framingMessageId String?       @unique
  /// The assistant answer message produced after the user responded.
  answerMessageId  String?       @unique
  /// FramingQuestion[]
  questions        Json
  /// FramingResponse[]; null until answered.
  responses        Json?
  /// Concept slugs the router tagged on the triggering message.
  conceptSlugs     String[]      @default([])
  /// LearnLaterCallout to queue (origin = skipped) if the user picks "just answer".
  skipCallout      Json?
  status           FramingStatus @default(pending)
  createdAt        DateTime      @default(now())
  answeredAt       DateTime?

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userMessage    Message      @relation("FramingUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  framingMessage Message?     @relation("FramingQuestionsMessage", fields: [framingMessageId], references: [id], onDelete: SetNull)
  answerMessage  Message?     @relation("FramingAnswerMessage", fields: [answerMessageId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([conversationId])
}

// ─── Learner profile ────────────────────────────────────────────────────────

/// Shared concept catalog (not per-user). The assessor upserts by slug.
model Concept {
  id          String   @id @default(cuid())
  /// kebab-case, e.g. "welch-t-test"
  slug        String   @unique
  name        String
  /// e.g. "hypothesis testing", "regression", "causal inference"
  domain      String?
  description String?
  createdAt   DateTime @default(now())

  mastery         ConceptMastery[]
  learnLaterItems LearnLaterItem[]
}

model ConceptMastery {
  id        String   @id @default(cuid())
  userId    String
  conceptId String
  /// 0..1
  score     Float    @default(0)
  /// MasteryEvidence[]: { note, delta, messageId?, at }
  evidence  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
}

/// Three style dimensions (P2). Sign conventions:
///   intuitionVsFormal: -1 = intuition first, +1 = formal first
///   briefVsThorough:   -1 = brief,           +1 = thorough
///   entryPoint:        code | concept | worked_example | null (unknown)
/// *Confidence fields are 0..1. *Overridden = user edited it at Tier 2, so the
/// assessor must not move that dimension any more.
model LearningStyle {
  id     String @id @default(cuid())
  userId String @unique

  intuitionVsFormal           Float   @default(0)
  intuitionVsFormalConfidence Float   @default(0)
  intuitionVsFormalOverridden Boolean @default(false)

  entryPoint           EntryPoint?
  entryPointConfidence Float       @default(0)
  entryPointOverridden Boolean     @default(false)

  briefVsThorough           Float   @default(0)
  briefVsThoroughConfidence Float   @default(0)
  briefVsThoroughOverridden Boolean @default(false)

  /// StyleEvidence[]: { dimension, note, at, messageId? }
  evidence  Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Inferred user context (P4). Editable at Tier 2.
model UserContext {
  id         String   @id @default(cuid())
  userId     String   @unique
  /// e.g. "MPH, epidemiology"
  field      String?
  projects   String[] @default([])
  dataTypes  String[] @default([])
  notes      String?
  /// True once the user has edited it; the assessor should then only append.
  userEdited Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearnLaterItem {
  id                   String           @id @default(cuid())
  userId               String
  conceptId            String?
  title                String
  /// Brief explanation shown on the card.
  preview              String
  /// How the concept applied where it came up.
  appliedContext       String
  sourceConversationId String?
  sourceMessageId      String?
  status               LearnLaterStatus @default(queued)
  origin               LearnLaterOrigin @default(flagged)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept            Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  sourceConversation Conversation?    @relation("LearnLaterSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage      Message?         @relation("LearnLaterSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  digInConversations Conversation[]   @relation("DigInConversations")
  slotImpressions    SlotImpression[]

  @@index([userId, status])
  @@index([sourceConversationId])
  @@index([sourceMessageId])
  @@index([conceptId])
}

// ─── End-of-answer slot experiment (E1–E5) ──────────────────────────────────

/// One end-of-answer slot shown under an immediate answer (lookup / task /
/// direct). Written in the same transaction as the answer message and the
/// featured LearnLaterItem (E3), only while EXPERIMENT.active. Tier-unlock
/// moments are never logged (E4). Engagement columns are filled by the
/// /api/slot/[id]/* routes; secondary metrics and the guardrail are derived in
/// src/lib/slot/results.ts.
///
/// Experiment data outlives the demo user: `userId`, `conversationId`,
/// `messageId` and `learnLaterItemId` are plain-text SNAPSHOTS (never
/// nulled), while the `*RefId` columns are the real foreign keys and are set
/// to NULL when the user (persona reset), conversation, message or item is
/// deleted. Query by the snapshot columns; join through the relations when
/// they're still there.
model SlotImpression {
  id             String @id @default(cuid())
  /// Snapshot of the session-clone User id (kept after a persona reset).
  userId         String
  /// Snapshot of the conversation id.
  conversationId String
  /// Snapshot of the answer message the slot sits under.
  messageId      String @unique
  /// The user message that triggered the answer (snapshot).
  userMessageId  String
  /// Answer mode of the answer — one of "lookup" | "task" | "direct"
  /// (ImmediateAnswerMode in src/lib/pipeline/route-policy.ts).
  answerMode     String

  // ── Live foreign keys (NULL once the row they point at is deleted) ──
  userRefId           String?
  conversationRefId   String?
  messageRefId        String? @unique
  learnLaterItemRefId String?

  // ── Featured hidden decision (E2, E3) ──
  /// Snapshot of the saved (always, E3) LearnLaterItem id.
  learnLaterItemId            String?
  /// Snapshot of what was featured (the item may later change or be deleted).
  featuredTitle               String
  featuredConceptSlug         String?
  /// The user's mastery score on the featured concept when the slot was
  /// shown; null when there is no concept or no mastery yet (E5 mastery delta).
  featuredMasteryAtImpression Float?
  /// Candidate snapshot in router order (a why card first):
  /// [{ title, conceptSlug, why, rank }] — rank is 1-based, null for the why card.
  candidates                  Json
  /// Ranked hidden-decision candidates offered to the E2 draw (excludes a why card).
  candidateCount              Int
  /// 1-based rank of the featured candidate; null when the why card was featured.
  featuredRank                Int?
  /// True when a task's whyCallout was featured (fixed, not randomized — L8).
  featuredIsWhy               Boolean @default(false)
  /// EXPERIMENT.topPickProbability at draw time.
  topPickProbability          Float

  // ── Variant (E1, E4) ──
  /// The variant actually shown.
  variant          SlotVariant
  /// The variant drawn — the randomized assignment; results group by this
  /// (intent-to-treat). Differs from `variant` only after a fallback.
  drawnVariant     SlotVariant
  /// Why `variant` differs from `drawnVariant`: "content_not_ready" | "content_failed".
  fallbackReason   String?
  eligibleVariants SlotVariant[]
  /// Weights snapshot for the eligible variants at draw time.
  weights          Json
  /// Dev-only forced variant (never in production). Excluded from results.
  forced           Boolean       @default(false)
  /// Variant payload as generated, including server-only fields (quick-check
  /// correct answer + explanation). Never sent raw to the client.
  payload          Json?
  createdAt        DateTime      @default(now())

  // ── Engagement (E5 primary) ──
  /// First engagement and when it happened.
  engagement            SlotEngagement?
  engagedAt             DateTime?
  digInAt               DateTime?
  digInConversationId   String?
  walkthroughStartedAt  DateTime?
  /// The FramingExchange the walk-through created.
  walkthroughExchangeId String?         @unique
  quickcheckAnsweredAt  DateTime?
  /// { selectedIndex: number | null, dontKnow: boolean, correct: boolean }
  quickcheckResponse    Json?
  applyClickedAt        DateTime?
  /// The answer message the apply-it answer produced.
  applyMessageId        String?

  user           User?           @relation(fields: [userRefId], references: [id], onDelete: SetNull)
  conversation   Conversation?   @relation(fields: [conversationRefId], references: [id], onDelete: SetNull)
  message        Message?        @relation(fields: [messageRefId], references: [id], onDelete: SetNull)
  learnLaterItem LearnLaterItem? @relation(fields: [learnLaterItemRefId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([conversationId])
  @@index([learnLaterItemId])
  @@index([userRefId])
  @@index([conversationRefId])
  @@index([learnLaterItemRefId])
}

// ─── Ops ────────────────────────────────────────────────────────────────────

/// Fixed-window rate limit (X3). One row per (key, window); increment with an
/// upsert on the composite id (hitRateLimit in src/lib/rate-limit.ts). Keys
/// come from RATE_LIMIT_KEYS in src/config.ts: "sess:<demoSessionId>",
/// "ip:<ip>", "global:<yyyy-mm-dd>", "pass:<ip>".
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}
